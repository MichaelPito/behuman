---
// Storie dei giornali (titoli raggruppati per storia, con le testate che la riprendono): partiti e temi.
import type { StoriaPartito } from "../lib/data";
import { annoDi, dataIt } from "../lib/data";

interface Props { storie: StoriaPartito[] }
const { storie } = Astro.props;
---
<ul class="storie">
  {storie.map((s) => (
    <li class="card storia" data-anno={annoDi(s.data)}>
      <div class="row" style="gap:6px">
        <span class="tiny mono muted">{dataIt(s.data)}</span>
        {s.n_testate > 1 && <span class="pill sky">{s.n_testate} testate</span>}
        {s.polemica && <span class="pill plum">polemica</span>}
      </div>
      <a href={s.url} target="_blank" rel="noopener">{s.titolo}</a>
      <span class="tiny muted">{s.fonte}</span>
      {s.articoli.length > 1 && (
        <details>
          <summary class="tiny">Gli altri titoli sulla stessa storia ({s.articoli.length - 1})</summary>
          <ul class="altri">{s.articoli.filter((a) => a.url !== s.url).map((a) => <li class="small"><a href={a.url} target="_blank" rel="noopener">{a.titolo}</a> <span class="tiny muted">{`${a.fonte ?? ""} · ${dataIt(a.data)}`}</span></li>)}</ul>
        </details>
      )}
    </li>
  ))}
</ul>

<style>
  .storie { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .storia { display: grid; gap: 6px; padding: 14px; min-width: 0; align-content: start; }
  .storia > a { font-weight: 600; }
  .storia summary { cursor: pointer; color: var(--accent-ink); font-weight: 600; }
  .altri { margin: 6px 0 0; padding-left: 16px; display: grid; gap: 4px; }
</style>
