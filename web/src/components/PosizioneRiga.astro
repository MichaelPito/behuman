---
import Icon from "./Icon.astro";
import type { Posizione } from "../lib/data";
import { dataIt, ETICHETTA_POSIZIONE, ETICHETTA_TIPO } from "../lib/data";

interface Props { p: Posizione }
const { p } = Astro.props;
const c = p.dettagli?.conteggi as Record<string, number> | undefined;
---
<div class="pr stack">
  <div class="row" style="gap:8px">
    <span class={`pos ${p.posizione}`}>{ETICHETTA_POSIZIONE[p.posizione]}</span>
    <span class="mono tiny muted">{dataIt(p.data)}</span>
    <span class="pill">{ETICHETTA_TIPO[p.tipo] ?? p.tipo}</span>
  </div>
  {p.citazione && <blockquote class="quote">«{p.citazione}»</blockquote>}
  <p class="small muted">{p.descrizione}</p>
  {c && <p class="tiny muted mono">{Object.entries(c).map(([k, v]) => `${k} ${v}`).join(" · ")}</p>}
  {p.dettagli?.nota && <p class="tiny muted">{p.dettagli.nota}</p>}
  {p.fonte_url && (
    <a class="tiny fonte" href={p.fonte_url} rel="noopener" target="_blank">Fonte ufficiale <Icon name="ext" /></a>
  )}
</div>
<style>
  .pr { gap: 6px; }
  .fonte { display: inline-flex; gap: 4px; align-items: center; width: fit-content; }
  .fonte :global(svg) { width: 12px; height: 12px; }
</style>
