---
import type { PoliticoBreve } from "../lib/data";
import { ETICHETTA_ORIENTAMENTO, iniziali, pct } from "../lib/data";
import { u } from "../lib/url";

interface Props { p: PoliticoBreve; i?: number }
const { p, i = 0 } = Astro.props;
const ind = Object.entries(p.indicatori || {});
const pres = ind.length ? ind.map(([, x]) => x.presenza.percentuale ?? 0).reduce((a, b) => Math.max(a, b), 0) : null;
const fed = ind.length ? ind.map(([, x]) => x.fedelta_gruppo.percentuale_allineati).find((x) => x != null) ?? null : null;
const cognome = p.nome.split(" ").slice(-1)[0];
---
<a
  class="card persona-card rise"
  style={`--i:${i}`}
  href={u(`/politici/${p.slug}/`)}
  data-card
  data-nome={`${p.nome} ${p.partito.nome} ${p.partito.sigla} ${p.ruolo}`.toLowerCase()}
  data-cognome={cognome.toLowerCase()}
  data-partito={p.partito.slug ?? "ind"}
  data-sesso={p.sesso ?? ""}
  data-orientamento={p.orientamento ?? "nd"}
  data-schieramento={p.schieramento}
  data-presenza={pres ?? -1}
  data-cambi={p.coerenza.cambi_totali}
>
  {p.foto ? (
    <img class="avatar" src={p.foto} data-nome={p.nome} alt="" loading="lazy" transition:name={`foto-${p.slug}`} />
  ) : (
    <span class="avatar ph" aria-hidden="true" transition:name={`foto-${p.slug}`}>{iniziali(p.nome)}</span>
  )}
  <div style="min-width:0">
    <h3 transition:name={`nome-${p.slug}`}>{p.nome}</h3>
    <div class="small muted">{p.ruolo}</div>
    <div class="meta">
      <span class="pill">{p.partito.sigla}</span>
      {p.orientamento && <span class="pill">{ETICHETTA_ORIENTAMENTO[p.orientamento]}</span>}
      <span class={`pill ${p.schieramento === "governo" ? "accent" : "plum"}`}>{p.schieramento === "governo" ? "Maggioranza" : "Opposizione"}</span>
    </div>
  </div>
  <div class="facts">
    <div class="fact"><div class="v">{pres == null ? "—" : pct(pres)}</div><div class="l">presenza al voto</div></div>
    <div class="fact"><div class="v">{fed == null ? "—" : pct(fed)}</div><div class="l">voti col gruppo</div></div>
    <div class="fact"><div class="v">{p.coerenza.cambi_totali}</div><div class="l">cambi di posizione</div></div>
  </div>
</a>
