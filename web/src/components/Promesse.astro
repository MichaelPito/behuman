---
// Prima e dopo l'incarico: cosa si chiedeva, cosa dice l'indicatore ufficiale, quali leggi.
// Nessun giudizio: l'esito è una regola fissa sul segno della variazione (vedi FAQ).
import Icon from "./Icon.astro";
import type { ImpegniPolitico, MisuraImpegno } from "../lib/data";
import { dataIt, ESITO_CLASSE, periodo, slugLegge, valore, variazione } from "../lib/data";
import { u } from "../lib/url";

interface Props { d: ImpegniPolitico }
const { d } = Astro.props;


// grafico: serie dal 2018, linea verticale all'inizio dell'incarico, punto alla prima richiesta
function grafico(m: MisuraImpegno, dal: string, prima: string | undefined) {
  const s = m.serie;
  const W = 320, H = 96, P = 6;
  // i dati annuali sono datati 1° gennaio: nel grafico stanno a metà dell'anno
  const t = (d: string) => new Date(m.frequenza === "annuale" && d.slice(5) === "01-01" ? `${d.slice(0, 4)}-07-01` : d).getTime();
  const x0 = t(s[0][0]), x1 = t(s[s.length - 1][0]);
  const vs = s.map((p) => p[1]);
  // scala sui valori della serie (non da zero), con un po' di margine: si vedono le variazioni
  const mn = Math.min(...vs), mx = Math.max(...vs), pad = (mx - mn) * 0.15 || Math.abs(mx) * 0.05 || 1;
  const lo = mn - pad, hi = mx + pad;
  const X = (d: string) => P + ((t(d) - x0) / (x1 - x0 || 1)) * (W - 2 * P);
  const Y = (v: number) => H - P - ((v - lo) / (hi - lo || 1)) * (H - 2 * P);
  const linea = s.map((p, i) => `${i ? "L" : "M"}${X(p[0]).toFixed(1)},${Y(p[1]).toFixed(1)}`).join(" ");
  const area = `${linea} L${X(s[s.length - 1][0]).toFixed(1)},${H - P} L${X(s[0][0]).toFixed(1)},${H - P} Z`;
  const xi = t(dal) >= x0 ? X(dal) : null;
  const xp = prima && t(prima) >= x0 ? X(prima) : null;
  return { W, H, P, linea, area, xi, xp, yOggi: Y(s[s.length - 1][1]), xOggi: X(s[s.length - 1][0]) };
}
const VERBO: Record<string, string> = { abolizione: "abolire", riduzione: "ridurre", aumento: "aumentare" };
---
<div class="promesse">
  <p class="callout sun small riep"><Icon name="scale" class="tiny" /> {d.riepilogo.testo} <a href={u("/faq/#promesse")}>Come lo misuriamo</a></p>
  {d.temi.map((t) => (
    <article class="card tema">
      <header class="row testa">
        <h3>{t.nome}</h3>
        <span class={`pill ${ESITO_CLASSE[t.esito] ?? ""}`}>{t.esito_etichetta}</span>
      </header>
      <p class="small">{t.testo}</p>

      <div class="colonne">
        <section class="prima">
          <h4><span class="dot"></span>Prima dell'incarico (dal {dataIt(d.incarico.dal)} è {d.incarico.carica})</h4>
          <ul class="frasi">
            {[...t.prima].reverse().slice(0, 3).map((f) => (
              <li>
                <span class="tiny mono muted">{dataIt(f.data)} · {f.fonte}</span>
                <blockquote>«{f.frase}»</blockquote>
                {(f as any).testo_pubblicato && <span class="small muted">Testo pubblicato con il video: «{(f as any).testo_pubblicato}»</span>}
                <span class="tiny">Chiede di <strong>{VERBO[f.direzione ?? ""] ?? "intervenire"}</strong> («{f.verbo}») · <a href={f.url} target="_blank" rel="noopener">fonte <Icon name="ext" class="tiny" /></a>{f.verifica && <> · <a href={f.verifica} target="_blank" rel="noopener">verifica</a></>}</span>
                {(f as any).verifica_note && <span class="tiny muted">Verificata con: {((f as any).verifica_note as string[]).join("; ")}</span>}
              </li>
            ))}
            {t.programma.slice(0, 2).map((f) => (
              <li class="prog">
                <span class="tiny mono muted">Programma per le elezioni del 25 settembre 2022 · {f.sezione}</span>
                <blockquote>«{f.frase}»</blockquote>
                <span class="tiny">{f.fonte} · <a href={f.url} target="_blank" rel="noopener">documento <Icon name="ext" class="tiny" /></a></span>
              </li>
            ))}
          </ul>
          {(t.prima_totale > 3 || t.programma_totale > 2) && <p class="tiny muted">In tutto: {t.prima_totale} frasi sue e {t.programma_totale} punti del programma del partito.</p>}
        </section>

        <section class="dopo">
          <h4><span class="dot"></span>Dall'incarico a oggi</h4>
          {t.indicatori.map((m) => {
            const g = grafico(m, d.incarico.dal, [...t.prima, ...t.programma].map((f) => f.data).sort()[0]);
            return (
              <figure class="ind">
                <figcaption class="row" style="justify-content:space-between;gap:6px">
                  <span class="small"><strong>{m.nome}</strong></span>
                  <span class={`pill ${ESITO_CLASSE[m.esito] ?? ""}`}>{variazione(m.variazione_dall_incarico, m.differenza_dall_incarico, m)}</span>
                </figcaption>
                <svg viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-label={`${m.nome}: ${valore(m.all_incarico.valore, m)} all'inizio dell'incarico, ${valore(m.oggi.valore, m)} all'ultimo dato`}>
                  <path d={g.area} class="area" />
                  <path d={g.linea} class="linea" pathLength="1" />
                  {g.xp != null && <line x1={g.xp} x2={g.xp} y1={g.P} y2={g.H - g.P} class="mprima" />}
                  {g.xi != null && <line x1={g.xi} x2={g.xi} y1={g.P} y2={g.H - g.P} class="minc" />}
                  <circle cx={g.xOggi} cy={g.yOggi} r="3.5" class="oggi" />
                </svg>
                <dl class="valori">
                  {m.alla_prima_richiesta && m.alla_prima_richiesta.data < (m.un_anno_prima?.data ?? m.all_incarico.data) && (
                    <div><dt>Alla prima richiesta ({dataIt(m.alla_prima_richiesta.data)})</dt><dd>{valore(m.alla_prima_richiesta.valore, m)}</dd></div>
                  )}
                  {m.un_anno_prima && <div><dt>Un anno prima</dt><dd>{valore(m.un_anno_prima.valore, m)}</dd></div>}
                  <div><dt>All'incarico ({periodo(m.all_incarico.data, m)})</dt><dd>{valore(m.all_incarico.valore, m)}</dd></div>
                  <div><dt>Ultimo dato ({periodo(m.oggi.data, m)})</dt><dd>{valore(m.oggi.valore, m)}</dd></div>
                </dl>
                <p class="tiny muted">Dal {m.serie[0][0].slice(0, 4)} a oggi. <span class="leg minc"></span> inizio incarico <span class="leg mprima"></span> prima richiesta · Fonte: <a href={m.fonte_url} target="_blank" rel="noopener">{m.fonte}</a></p>
              </figure>
            );
          })}
          {t.leggi.length > 0 && (
            <details class="leggi">
              <summary class="small">Leggi del Governo sul tema: {t.leggi.length}</summary>
              <ul>{t.leggi.map((l) => <li class="small"><span class="mono tiny muted">{dataIt(l.data)}</span> <a href={u(`/governo/${slugLegge(l)}/`)}>{l.argomento}</a></li>)}</ul>
            </details>
          )}
          {t.dopo.length > 0 && (
            <details class="leggi">
              <summary class="small">Cosa ha detto sul tema da quando governa: {t.dopo_totale} frasi</summary>
              <ul class="frasi">
                {[...t.dopo].reverse().slice(0, 4).map((f) => (
                  <li><span class="tiny mono muted">{dataIt(f.data)} · {f.fonte}</span><blockquote>«{f.frase}»</blockquote><a class="tiny" href={f.url} target="_blank" rel="noopener">fonte <Icon name="ext" class="tiny" /></a></li>
                ))}
              </ul>
            </details>
          )}
        </section>
      </div>
    </article>
  ))}
</div>

<style>
  .promesse { display: grid; gap: 16px; }
  .riep { display: block; }
  .tema { display: grid; gap: 14px; padding: 20px; border-top: 3px solid var(--sun); }
  .testa { justify-content: space-between; gap: 8px; }
  .colonne { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  h4 { margin: 0 0 8px; font-size: 0.78rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-2); display: flex; gap: 8px; align-items: center; }
  .prima .dot, .dopo .dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
  .prima .dot { background: var(--sun); }
  .dopo .dot { background: var(--accent); }
  .frasi { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .frasi li { display: grid; gap: 3px; border-left: 3px solid var(--sun-wash); padding-left: 10px; }
  .frasi li.prog { border-left-color: var(--sky-wash); }
  blockquote { margin: 0; font: 500 0.98rem/1.45 var(--f-display); }
  .ind { margin: 0 0 12px; display: grid; gap: 6px; }
  .ind svg { width: 100%; height: auto; max-height: 120px; }
  .area { fill: color-mix(in srgb, var(--accent) 12%, transparent); }
  .linea { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; animation: traccia 1.4s var(--ease) forwards; }
  @keyframes traccia { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .linea { stroke-dashoffset: 0; animation: none; } }
  .minc { stroke: var(--plum); stroke-width: 2; stroke-dasharray: 3 3; }
  .mprima { stroke: var(--sun); stroke-width: 2; stroke-dasharray: 2 3; }
  .oggi { fill: var(--accent); stroke: var(--surface); stroke-width: 2; }
  .valori { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 6px; margin: 0; }
  .valori dt { font-size: 0.72rem; color: var(--ink-2); }
  .valori dd { margin: 0; font: 600 0.95rem var(--f-mono); }
  .leg { display: inline-block; width: 14px; height: 0; border-top: 2px dashed; vertical-align: middle; margin: 0 2px 0 6px; }
  .leg.minc { border-color: var(--plum); }
  .leg.mprima { border-color: var(--sun); }
  .leggi summary { cursor: pointer; color: var(--accent-ink); font-weight: 600; }
  .leggi ul { margin: 8px 0 0; padding-left: 16px; display: grid; gap: 6px; }
  .leggi .frasi { padding-left: 0; }
</style>
