---
// Partecipazione mensile al voto, in ordine cronologico. SVG statico, colori dai token del tema.
interface Props {
  mesi: { mese: string; presenti: number; totale: number; missione?: number }[];
  mediana?: number | null;
}
const { mesi, mediana } = Astro.props;
const W = 760, H = 210, P = { t: 14, r: 10, b: 28, l: 36 };
const n = Math.max(mesi.length, 1);
const bw = (W - P.l - P.r) / n;
const y = (v: number) => P.t + (H - P.t - P.b) * (1 - v / 100);
const MESI = ["gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago", "set", "ott", "nov", "dic"];
const conMissione = mesi.some((m) => (m.missione ?? 0) > 0);
---
<figure class="stack" style="margin:0">
  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Partecipazione mensile alle votazioni in percentuale">
    {[0, 25, 50, 75, 100].map((v) => (
      <g>
        <line x1={P.l} x2={W - P.r} y1={y(v)} y2={y(v)} stroke="var(--line)" stroke-dasharray={v === 0 ? undefined : "2 4"} />
        <text x={P.l - 6} y={y(v) + 3} text-anchor="end" class="ax">{v}%</text>
      </g>
    ))}
    {mesi.map((m, i) => {
      const v = m.totale ? (100 * m.presenti) / m.totale : 0;
      const mi = m.totale ? (100 * (m.missione ?? 0)) / m.totale : 0;
      return (
        <g style={`--d:${i * 12}`} class="bar">
          {mi > 0 && <rect x={P.l + i * bw + 1} width={Math.max(bw - 2, 1)} y={y(v + mi)} height={y(0) - y(mi)} fill="var(--line)" rx="1.5" />}
          <rect x={P.l + i * bw + 1} width={Math.max(bw - 2, 1)} y={y(v)} height={Math.max(y(0) - y(v), 0)} fill="var(--accent)" rx="1.5">
            <title>{`${MESI[Number(m.mese.slice(5)) - 1]} ${m.mese.slice(0, 4)}: ${v.toFixed(1)}% (${m.presenti} su ${m.totale} votazioni)${mi ? `, in congedo o missione ${mi.toFixed(1)}%` : ""}`}</title>
          </rect>
        </g>
      );
    })}
    {mesi.map((m, i) => (m.mese.endsWith("-01") ? <text x={P.l + i * bw} y={H - 9} class="ax">{m.mese.slice(0, 4)}</text> : null))}
    {mediana != null && (
      <g>
        <line x1={P.l} x2={W - P.r} y1={y(mediana)} y2={y(mediana)} stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="6 4" />
        <text x={W - P.r} y={y(mediana) - 6} text-anchor="end" class="ax strong">mediana dell'Aula {String(mediana).replace(".", ",")}%</text>
      </g>
    )}
  </svg>
  <figcaption class="legend">
    <span><i style="background:var(--accent)"></i>Ha votato</span>
    {conMissione && <span><i style="background:var(--line)"></i>In congedo o missione</span>}
    {mediana != null && <span><i style="background:var(--ink);height:2px;border-radius:0"></i>Mediana dei colleghi</span>}
  </figcaption>
</figure>
<style>
  .chart { width: 100%; height: auto; display: block; }
  .ax { fill: var(--ink-2); font: 500 11px var(--f-mono); }
  .ax.strong { fill: var(--ink); }
  .bar { animation: up 0.6s var(--ease) both; animation-delay: calc(var(--d) * 1ms); transform-origin: bottom; transform-box: fill-box; }
  @keyframes up { from { opacity: 0; transform: scaleY(0.2); } }
</style>
