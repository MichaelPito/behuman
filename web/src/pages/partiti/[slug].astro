---
import Base from "../../layouts/Base.astro";
import Cambio from "../../components/Cambio.astro";
import Coerenza from "../../components/Coerenza.astro";
import Icon from "../../components/Icon.astro";
import PosizioneRiga from "../../components/PosizioneRiga.astro";
import ScalaPosizione from "../../components/ScalaPosizione.astro";
import { dataIt, ETICHETTA_ORIENTAMENTO, ordinaPerData, partiti, partito, politici, proposizioniIndice } from "../../lib/data";
import { u } from "../../lib/url";

export function getStaticPaths() {
  return partiti().map((p) => ({ params: { slug: p.slug } }));
}
const p = partito(Astro.params.slug!);
const props = proposizioniIndice();
const perProp: Record<string, typeof p.posizioni> = {};
for (const x of ordinaPerData(p.posizioni)) (perProp[x.proposizione] ||= []).push(x);
const cambi = [...p.cambi_posizione].sort((a, b) => a.dopo.data.localeCompare(b.dopo.data));
const misure: any[] = p.ideologia?.misure || [];
const serie = (chiave: string) => {
  const righe = misure.filter((m) => m.chiave === chiave);
  const ids = [...new Set(righe.map((m) => m.id_ches))];
  return ids.map((id) => ({ id, punti: righe.filter((m) => m.id_ches === id).map((m) => ({ anno: m.anno, valore: m.valore, sigla: m.sigla_ches })) }));
};
const lr = serie("lrgen");
const eu = serie("eu_position");
const gt = serie("galtan");
const membri = politici().filter((x) => x.partito.slug === p.slug);
const prog = p.ideologia?.programma_2022;
---
<Base title={p.nome} description={`${p.nome}: coalizioni, voti del gruppo parlamentare, posizionamento e cambi di posizione documentati.`}>
  <section class="section">
    <div class="stack" style="gap:10px">
      <span class="eyebrow">{p.schieramento === "governo" ? "Oggi nella maggioranza di governo" : p.schieramento === "opposizione" ? "Oggi all'opposizione" : "Partito"}</span>
      <h1>{p.nome} <span class="muted sig">{p.sigla}</span></h1>
      <div class="row" style="gap:6px">
        {p.orientamento?.etichetta ? <span class="pill accent">Orientamento: {ETICHETTA_ORIENTAMENTO[p.orientamento.etichetta].toLowerCase()} (CHES {p.orientamento.anno})</span> : <span class="pill">Orientamento non misurato</span>}
        <a class="chip" href={p.wikidata} rel="noopener" target="_blank">Wikidata <Icon name="ext" class="i-ext" /></a>
        {p.sito && <a class="chip" href={p.sito} rel="noopener" target="_blank">Sito ufficiale <Icon name="ext" class="i-ext" /></a>}
        {prog && <a class="chip" href={prog.url} rel="noopener" target="_blank">Programma 2022 <Icon name="doc" class="i-ext" /></a>}
      </div>
      {!p.attivo && <p class="callout plum">Partito non più attivo: i dati si fermano al {dataIt(p.periodo.al)}.</p>}
    </div>
  </section>

  <section class="section">
    <h2>In breve</h2>
    <div class="breve">
      <div class="card stack">
        <span class="eyebrow">Sintesi dai dati</span>
        <ul class="sintesi">{(p.sintesi ?? []).map((s) => <li>{s}</li>)}</ul>
        {p.note && <p class="small muted">{p.note}</p>}
      </div>
      <Coerenza v={p.valutazione_coerenza} />
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Posizionamento nel tempo</h2><a class="small" href={u("/faq/#orientamento")}>Come leggerlo</a></div>
    {misure.length === 0 && <p class="callout neutral">Il partito non è presente nel Chapel Hill Expert Survey per il periodo.</p>}
    {misure.length > 0 && (
      <div class="card stack" style="gap:22px">
        {lr.map((s) => <ScalaPosizione nome={`Sinistra–destra${lr.length > 1 ? ` (${s.punti.at(-1)?.sigla})` : ""}`} min={0} max={10} estremi={["0 · estrema sinistra", "estrema destra · 10"]} punti={s.punti} fasce={[{ da: 0, a: 4, label: "sinistra" }, { da: 4, a: 6, label: "centro" }, { da: 6, a: 10, label: "destra" }]} />)}
        {eu.map((s) => <ScalaPosizione nome={`Integrazione europea${eu.length > 1 ? ` (${s.punti.at(-1)?.sigla})` : ""}`} min={1} max={7} estremi={["1 · fortemente contrari", "fortemente favorevoli · 7"]} punti={s.punti} />)}
        {gt.map((s) => <ScalaPosizione nome={`Valori progressisti–tradizionali${gt.length > 1 ? ` (${s.punti.at(-1)?.sigla})` : ""}`} min={0} max={10} estremi={["0 · progressisti", "tradizionali · 10"]} punti={s.punti} />)}
        <p class="tiny muted">Fonte: {misure[0].fonte}. Medie delle valutazioni di esperti accademici; il pallino pieno è la rilevazione più recente.</p>
      </div>
    )}
  </section>

  <section class="section">
    <h2>Al governo o all'opposizione</h2>
    <div class="card">
      <ol class="timeline">
        {[...p.coalizioni].sort((a, b) => a.inizio.localeCompare(b.inizio)).map((c) => (
          <li>
            <div class="when">{dataIt(c.inizio)} → {c.fine ? dataIt(c.fine) : "in corso"}</div>
            <div class="what">{c.governo}: {c.ruolo}</div>
            {c.nota && <div class="tiny muted">{c.nota}</div>}
            {c.fonte && <a class="tiny" href={c.fonte} rel="noopener" target="_blank">Fonte: Camera dei Deputati ↗</a>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Cambi di posizione</h2><span class="small muted">dal più vecchio al più recente</span></div>
    {cambi.length === 0 && <p class="callout neutral">Nessun cambio rilevato sui temi monitorati finora.</p>}
    <div class="grid">{cambi.map((c, i) => <Cambio c={c} i={i} />)}</div>
  </section>

  <section class="section">
    <h2>Posizioni per tema</h2>
    {Object.entries(perProp).map(([pid, lista]) => (
      <details class="disc">
        <summary><span>«{props[pid]?.testo ?? pid}» <span class="muted small">· {lista.length}</span></span><Icon name="chev" class="chev" /></summary>
        <div class="body"><ol class="timeline">{lista.map((x) => <li><PosizioneRiga p={x} /></li>)}</ol></div>
      </details>
    ))}
  </section>

  <section class="section">
    <h2>Esponenti monitorati</h2>
    <div class="grid three">
      {membri.map((m) => (
        <a class="card link" href={u(`/politici/${m.slug}/`)}><strong>{m.nome}</strong><div class="small muted">{m.ruolo}</div></a>
      ))}
    </div>
    <p class="tiny muted">Gruppi parlamentari considerati: Camera {p.gruppi_parlamentari.Camera.join(", ") || "—"}; Senato (numero del gruppo) {p.gruppi_parlamentari.Senato.join(", ") || "—"}.</p>
  </section>
</Base>

<style>
  .sig { font: 500 0.55em var(--f-body); }
  .breve { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 16px; align-items: start; }
  @media (max-width: 860px) { .breve { grid-template-columns: 1fr; } }
  .sintesi { margin: 0; padding-left: 20px; display: grid; gap: 10px; }
  .sintesi li::marker { color: var(--accent); }
</style>
