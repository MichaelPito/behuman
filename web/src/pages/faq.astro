---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { mediane, meta } from "../lib/data";
import { u } from "../lib/url";

const m = meta();
const med = mediane();
const fmt = (n: number | null | undefined) => (n == null ? "n.d." : `${String(n).replace(".", ",")}%`);

const BREVE: Record<string, string> = {
  presenza: "Presenza al voto", mediana: "Mediana dell'Aula", fedelta: "Voti come il gruppo", cambi: "Cambi di posizione",
  coerenza: "Coerenza", partito: "Posizione dei partiti", orientamento: "Orientamento", sesso: "Sesso", sintesi: "Sintesi",
  dichiarazioni: "Dichiarazioni", sunto: "Sunto", virali: "Più discusse", polemiche: "Notizie e polemiche", promesse: "Prima e dopo l'incarico", governo: "Pagina Governo", aggiornamento: "Aggiornamenti", errori: "Errori",
};
type Q = { id: string; q: string; a: string[]; formula?: string; esempio?: string };
const gruppi: { titolo: string; voci: Q[] }[] = [
  {
    titolo: "I numeri delle schede",
    voci: [
      {
        id: "presenza",
        q: "Come si calcola la «presenza al voto»?",
        formula: "presenza = votazioni in cui ha votato ÷ votazioni del periodo in cui era in carica × 100",
        a: [
          "Contiamo tutte le votazioni elettroniche dell'Aula registrate da Camera e Senato negli ultimi 5 anni, solo per i mesi in cui la persona era in carica.",
          "«Ha votato» vuol dire: favorevole, contrario, astenuto, oppure ha partecipato a un voto segreto. Al Senato contiamo anche chi presiede la seduta.",
          "Al Senato le assenze «in congedo o missione» (incarichi istituzionali) sono contate a parte e mostrate in grigio nel grafico. La Camera non pubblica questa distinzione: un ministro in missione risulta semplicemente «non ha votato».",
        ],
        esempio: `Se un deputato ha votato in 8.327 votazioni su 21.956, la presenza è 37,9%.`,
      },
      {
        id: "mediana",
        q: "Cos'è la «mediana dell'Aula» con cui confrontate le presenze?",
        a: [
          "È il valore centrale: metà dei membri della stessa Camera, nello stesso periodo, ha una presenza più alta e metà più bassa. Escludiamo chi ha meno di 100 votazioni (per esempio chi è entrato da poco).",
          `Oggi la mediana della Camera è ${fmt(med.Camera)}. Per il Senato il calcolo non è ancora disponibile: il servizio dati del Senato limita le richieste e stiamo lavorando a un metodo che lo rispetti.`,
          "Non esiste una soglia «giusta»: chi ha un incarico di governo o guida un partito vota strutturalmente meno spesso. Per questo mostriamo sempre il ruolo accanto al numero.",
        ],
      },
      {
        id: "fedelta",
        q: "Come si calcolano i «voti come il gruppo»?",
        formula: "voti come il gruppo = voti uguali alla linea del gruppo ÷ (voti uguali + voti diversi) × 100",
        a: [
          "Guardiamo solo i voti finali sulle leggi e i voti di fiducia, cioè le votazioni più importanti.",
          "La «linea del gruppo» è il voto più frequente tra i colleghi dello stesso gruppo parlamentare in quella votazione (favorevole, contrario o astenuto). Se c'è parità o nessuno ha votato, la linea non è determinabile e quella votazione non conta.",
          "Le votazioni in cui la persona non ha votato non entrano nel calcolo. Nella scheda puoi vedere l'elenco dei voti diversi dal gruppo, anno per anno.",
        ],
      },
      {
        id: "cambi",
        q: "Quando registrate un «cambio di posizione»?",
        a: [
          "Partiamo da una proposizione scritta in modo neutro, su cui si può essere a favore o contro (per esempio «Autorizzare la cessione di mezzi militari all'Ucraina»).",
          "A ogni proposizione colleghiamo voti finali in Aula il cui oggetto principale coincide con essa, e dichiarazioni testuali verificate.",
          "Un cambio è registrato in modo automatico quando due prese di posizione consecutive della stessa persona (o dello stesso partito) sono una a favore e una contro. Le astensioni compaiono nella cronologia ma non creano un cambio.",
          "Non diciamo se il cambio sia giusto o sbagliato, né perché sia avvenuto: cambiare idea può essere legittimo.",
        ],
      },
      {
        id: "coerenza",
        q: "Come funziona l'indicatore di coerenza?",
        formula: "coerenza = temi senza cambi di posizione / temi confrontabili",
        a: [
          "Un tema è «confrontabile» quando ci sono almeno due prese di posizione nette (a favore o contro) nel periodo.",
          "L'arco ha un segmento per tema confrontabile: petrolio se non ci sono stati cambi, prugna se c'è stato almeno un cambio.",
          "Se i temi confrontabili sono zero mostriamo «dati insufficienti» invece di un numero: con pochi dati un punteggio sarebbe fuorviante.",
          "Non combiniamo coerenza, presenze e fedeltà in un unico voto: qualunque peso daremmo a ciascuno sarebbe una scelta soggettiva.",
        ],
      },
      {
        id: "partito",
        q: "Come si stabilisce la posizione di un partito?",
        a: [
          "Per ogni voto collegato a un tema prendiamo il voto più frequente del suo gruppo parlamentare, e mostriamo sempre i conteggi completi (es. «Favorevole 102, Contrario 2, Non ha votato 49»).",
          "Quando due partiti hanno avuto un gruppo comune (Azione e Italia Viva fino a novembre 2023), il voto del gruppo comune vale per entrambi, e lo segnaliamo.",
        ],
      },
    ],
  },
  {
    titolo: "Orientamento, sesso, sintesi",
    voci: [
      {
        id: "orientamento",
        q: "Come assegnate l'orientamento sinistra, centro o destra?",
        formula: "lrgen < 4 → sinistra · 4 ≤ lrgen ≤ 6 → centro · lrgen > 6 → destra",
        a: [
          "Non lo decidiamo noi. Usiamo il Chapel Hill Expert Survey (CHES), un'indagine accademica in cui centinaia di esperti valutano i partiti europei su scale fisse. La misura «lrgen» va da 0 (estrema sinistra) a 10 (estrema destra).",
          "Prendiamo l'ondata più recente (2024) e dividiamo la scala in tre fasce simmetriche attorno al centro (5). Per un partito con più componenti misurate separatamente (AVS: Sinistra Italiana ed Europa Verde) usiamo la media.",
          "L'orientamento di un politico è quello del suo partito. Italia Viva e Noi Moderati non sono misurati dal CHES 2024: compaiono come «non misurato». Gli indipendenti non hanno orientamento.",
          "Nella pagina di ogni partito trovi i valori numerici e il confronto con l'ondata precedente (2019).",
        ],
      },
      {
        id: "sesso",
        q: "Da dove viene il dato sul sesso?",
        a: ["Da Wikidata (proprietà «sesso o genere»), una base dati pubblica e collaborativa. Se trovi un errore puoi correggerlo direttamente su Wikidata."],
      },
      {
        id: "sintesi",
        q: "Chi scrive la «sintesi» in cima alle schede?",
        a: [
          "Nessuno la scrive a mano e non la genera un'intelligenza artificiale. È composta da frasi fisse riempite con i numeri della scheda (presenze, fedeltà, cambi, incarichi).",
          "Così la sintesi è sempre coerente con i dati e non contiene aggettivi o interpretazioni. Ogni frase rimanda a una sezione della pagina dove trovi le fonti.",
        ],
      },
    ],
  },
  {
    titolo: "Dichiarazioni, governo e opinione pubblica",
    voci: [
      {
        id: "dichiarazioni",
        q: "Da dove vengono le dichiarazioni?",
        a: [
          "Interventi nell'Aula della Camera: dai resoconti stenografici ufficiali, parola per parola. Mostriamo l'inizio di ogni intervento (circa 400 caratteri) con il link al punto esatto del resoconto. Chi presiede la seduta non è contato.",
          "Interventi nell'Aula del Senato: data, seduta e disegni di legge discussi, da dati.senato.it. Il testo non c'è perché il sito del Senato non ne permette il download automatico.",
          "Palazzo Chigi: interventi della Presidente del Consiglio pubblicati su governo.it (licenza CC BY 3.0 IT), dall'inizio del Governo in carica.",
          "Le dichiarazioni che usiamo per le posizioni sui temi sono diverse: citazioni testuali con fonte primaria e copia d'archivio, verificate da due persone prima della pubblicazione.",
          "Il recap di ogni politico è fatto solo di conteggi (quanti interventi, dove, in quali anni, in quali occasioni). L'«occasione» alla Camera è il tipo di dibattito scritto nel resoconto: question time, mozioni, leggi in esame, informative del Governo e così via.",
        ],
      },
      {
        id: "sunto",
        q: "Come fate il sunto di un intervento?",
        a: [
          "Il sunto è estrattivo: scegliamo 2 o 3 frasi intere dal testo ufficiale, con le parole dell'oratore. Nessuna riscrittura e nessun modello linguistico.",
          "Si scartano formule di cortesia e di procedura («Grazie, Presidente», «annuncio il voto…») e gli appellativi iniziali. Ogni frase riceve un punteggio: quanto contiene le parole su cui l'oratore torna più spesso in quell'intervento (somma delle frequenze divisa per la radice della lunghezza), con un piccolo bonus per numeri e per la prima frase di merito. Le migliori restano nell'ordine originale.",
          "«Di cosa parla più spesso» conta gli interventi che toccano un'area (economia, fisco, lavoro e pensioni, immigrazione, sanità, energia, esteri e difesa, giustizia…) con un elenco pubblico di parole chiave: servono almeno due parole dell'area nello stesso intervento.",
          "Accanto a ogni sunto c'è il link al testo ufficiale integrale: è quello che fa fede.",
        ],
      },
      {
        id: "virali",
        q: "Come scegliete le dichiarazioni «più discusse»?",
        a: [
          "Visualizzazioni e condivisioni sui social non sono accessibili in modo libero e verificabile, e premiano chi ha più follower. Per questo non usiamo «mi piace» né visualizzazioni.",
          "Usiamo un segnale pubblico e controllabile: una dichiarazione è «discussa» quando Pagella Politica, fact-checker indipendente, l'ha scelta per una verifica. Lo fa per le frasi che circolano di più nel dibattito pubblico.",
          "Riportiamo la frase, la data, dove è stata detta, i link alla fonte originale e alla verifica e il giudizio del fact-checker, sempre indicato come suo. Quando la frase è un'affermazione misurabile, aggiungiamo il nostro confronto automatico con i dati ufficiali.",
          "Se la fonte originale è un resoconto della Camera che abbiamo, mostriamo anche il passaggio ufficiale.",
        ],
      },
      {
        id: "polemiche",
        q: "Come funziona la pagina «Notizie e polemiche»?",
        a: [
          "Ogni giorno raccogliamo da Google News i titoli degli ultimi giorni che nominano ciascun politico monitorato. Non copiamo gli articoli: titolo, testata, data e link.",
          "I titoli che parlano della stessa storia (molte parole in comune, entro 3 giorni) vengono raggruppati. Il numero di testate diverse è il nostro segnale di diffusione: da 3 in su la storia è «diffusa». Una storia è una «polemica» se i titoli contengono parole come polemica, bufera, scontro, attacco, gaffe; è «nata sui social» se parlano anche di post, video, tweet, Instagram, TikTok. Gli elenchi di parole sono pubblici (config/osservatorio.yaml).",
          "Le parole del politico vengono prese solo dai titoli che le riportano tra virgolette subito dopo il suo nome («Nordio: “…”»). I titoli con più nomi insieme non vengono attribuiti a nessuno.",
          "Confronto con i dati: quando una frase afferma che un indicatore è salito o sceso («sbarchi dimezzati», «ha aumentato le accise», «disoccupazione in calo», «tagli alla sanità», «bollette aumentate»; tutti gli indicatori sono nella pagina «I numeri»), con la parola di direzione attaccata a quella del tema, la confrontiamo con il dato ufficiale dall'inizio del governo al giorno in cui è stata detta. «I dati la confermano» se il dato è andato nella direzione detta (oltre ±1%), «la smentiscono» se è andato nella direzione opposta, «non mostrano variazioni rilevanti» se è rimasto entro ±1%. Per le accuse di assenza in Aula guardiamo la presenza al voto rispetto alla mediana dei colleghi.",
          "Confronto con le posizioni: se una frase tocca una proposizione del database (es. invio di armi all'Ucraina) e contiene parole che indicano chiaramente da che parte sta, la confrontiamo con la sua ultima posizione documentata (voto o dichiarazione verificata). Se le parole non bastano a capire la posizione, colleghiamo solo il tema e lasciamo il confronto a chi legge. Lo stesso per le promesse fatte prima dell'incarico.",
          "Contenuti virali verificati: riportiamo le verifiche di Facta, Open e Pagella Politica che riguardano i politici monitorati, con il loro giudizio indicato come loro, e accanto il nostro confronto con i dati quando possibile.",
          "Sono regole automatiche: possono sbagliare su frasi ironiche o complesse. Ogni voce ha il link alla fonte: se trovi un errore, segnalalo e correggiamo la regola per tutti.",
        ],
      },
      {
        id: "in-discussione",
        q: "Da dove viene la pagina «In discussione»?",
        a: [
          "Dagli open data del Senato (dati.senato.it), che registrano il percorso di ogni disegno di legge in entrambe le Camere: numero (C. per la Camera, S. per il Senato), chi l'ha proposto, a che punto è e da quando, la commissione che lo esamina e i temi della classificazione ufficiale (Teseo). Gli stati ufficiali («esame in comm.», «all'esame assemblea»…) sono riscritti in parole semplici.",
          "Decreti-legge da convertire: i disegni di legge di conversione non ancora approvati definitivamente. La scadenza è la data del decreto più 60 giorni: è indicativa, perché i 60 giorni contano dalla pubblicazione in Gazzetta Ufficiale, di solito lo stesso giorno.",
          "In Aula: i testi il cui stato ufficiale è «all'esame dell'Assemblea». Le proposte sullo stesso tema esaminate insieme (stessa Camera, stesso giorno, titoli molto simili) sono raggruppate. Quelle in Aula da più di due mesi senza cambiamenti sono in un elenco a parte.",
          "Approvate, nuove proposte e lavoro nelle commissioni: i cambiamenti di stato e le presentazioni degli ultimi 14 giorni. Indichiamo quando tra i proponenti c'è uno dei politici monitorati.",
          "Consiglio dei ministri: i provvedimenti del comunicato ufficiale di ogni riunione dell'ultimo mese, con la descrizione del Governo, riportata come sua.",
          "Cosa scrivono i giornali: per i decreti, i testi in Aula e fino a 30 testi in commissione e 30 nuove proposte al giorno (prima quelli del Governo e dei politici monitorati, poi i più recenti) cerchiamo su Google News i titoli degli ultimi 7 giorni, con il nome breve ufficiale del testo (es. «decreto scuola») o con le parole che lo distinguono. Teniamo solo i titoli che parlano di un atto (decreto, legge, Camera, Senato, emendamenti…) e che contengono almeno due di quelle parole, di cui una specifica («piscine», non solo «salute» e «sicurezza»), oppure una parola lunga e specifica («commercialisti»). Al massimo due titoli per testata. È un segnale di quanto se ne parla, non una valutazione.",
        ],
      },
      {
        id: "numeri",
        q: "Da dove vengono «I numeri» e come li leggete?",
        a: [
          "Sono indicatori ufficiali scaricati ogni giorno da fonti pubbliche: Eurostat (che pubblica i dati ISTAT per l'Italia: lavoro, prezzi, energia, conti pubblici, PIL, spesa pubblica per funzione, nascite, povertà), il Ministero dell'Ambiente e della Sicurezza Energetica (prezzi settimanali dei carburanti con accise) e UNHCR (sbarchi, su dati del Ministero dell'Interno). Ogni scheda ha il link alla tabella originale.",
          "Per ogni indicatore mostriamo l'ultimo valore disponibile prima dell'inizio del governo in carica, l'ultimo valore pubblicato e la variazione. Per i tassi in percentuale (disoccupazione, inflazione, debito in % del PIL…) la variazione è in punti: dal 8,0% al 6,2% sono −1,8 punti. Per gli altri è in percentuale.",
          "Ogni dato si riferisce a un periodo (mese, trimestre, semestre, anno) e lo indichiamo. I dati annuali arrivano con uno o due anni di ritardo; i prezzi di luce e gas sono semestrali; lo spread è la media mensile della differenza tra i rendimenti dei titoli di Stato a 10 anni di Italia e Germania.",
          "Non coloriamo i numeri come buoni o cattivi e non diciamo di chi è il merito: un indicatore dipende anche da fattori esterni. La freccia indica solo la direzione, quando la variazione supera ±1%.",
        ],
      },
      {
        id: "promesse",
        q: "Come confrontate cosa chiedevano prima dell'incarico con cosa è successo dopo?",
        a: [
          "Vale per i politici monitorati che hanno oggi un incarico di governo. «Prima» vuol dire prima della data di inizio di quell'incarico (dati della Camera dei Deputati).",
          "Le frasi vengono da fonti con data: resoconti dell'Aula della Camera dal 2018, dichiarazioni scelte da Pagella Politica (qualsiasi data) e il programma del loro partito per le elezioni del 25 settembre 2022 (il PDF depositato al Ministero dell'Interno e, dove esiste, il programma completo del partito).",
          "Se una richiesta importante sta solo in un video o in un post (non coperti dalle fonti automatiche), si aggiunge a mano nel file pubblico contenuti/impegni.yaml con il link all'originale e almeno due riscontri indipendenti delle parole esatte (es. il video di Giorgia Meloni del 6 maggio 2019 sulle accise: descrizione pubblicata sul canale ufficiale di Fratelli d'Italia e trascrizione di Pagella Politica). Anche queste frasi passano dalle stesse regole automatiche.",
          "Una frase conta come richiesta solo se contiene la parola del tema (es. «accise») e, poco prima, un verbo che indica cosa si chiede (ridurre, tagliare, abolire, fermare…). Nei discorsi il verbo deve essere una richiesta («tagliare», «aboliremo», «chiediamo che siano abolite»): le descrizioni («le tasse diminuiranno», «abbiamo ridotto») e le frasi con «non» subito prima non contano. Temi, parole e verbi sono in un file pubblico, uguale per tutti.",
          "Per i temi di cui si parla molto anche per criticare gli avversari (lavoro, prezzi, bollette, conti pubblici, sanità, scuola, difesa, natalità, povertà) la regola nei discorsi è più severa: conta solo una richiesta esplicita di chi parla («chiediamo», «vogliamo», «dobbiamo», «bisogna»…). Le domande retoriche e le frasi che riportano parole di altri («nelle parole di…», «se vuole abolire…») non contano.",
          "Ogni tema ha uno o più indicatori ufficiali, tutti nella pagina «I numeri»: accise e prezzo alla pompa di benzina e gasolio (Ministero dell'Ambiente e della Sicurezza Energetica), pressione fiscale, disoccupazione, occupati, inflazione, prezzo di luce e gas per le famiglie, debito, deficit, spread, PIL, spesa pubblica per sanità, istruzione e difesa, nascite, persone a rischio di povertà (Eurostat su dati ISTAT), persone sbarcate negli ultimi 12 mesi (UNHCR su dati del Ministero dell'Interno). Pensioni/legge Fornero e reddito di cittadinanza non hanno un indicatore numerico semplice: mostriamo solo le leggi.",
          "L'esito è una regola fissa sul valore all'inizio dell'incarico e sull'ultimo dato: «nella direzione chiesta» se l'indicatore è sceso di oltre l'1% quando si chiedeva di ridurlo (o salito quando si chiedeva di aumentarlo), «quasi invariato» entro ±1%, «nella direzione opposta» nel caso contrario, «obiettivo raggiunto» se si chiedeva di abolire e il valore è zero. Se un tema ha più indicatori che vanno in direzioni diverse (es. spesa sanitaria in euro su, in rapporto al PIL giù) l'esito è «misto». Mostriamo anche il valore di un anno prima dell'incarico, per vedere misure temporanee in corso all'insediamento (es. il taglio delle accise del 2022).",
          "Non diciamo se una promessa è stata «mantenuta»: un indicatore dipende anche da fattori esterni (prezzi internazionali, guerre, economia). Mostriamo le frasi, i numeri e le leggi, con le fonti; il giudizio resta a chi legge.",
        ],
      },
      {
        id: "governo",
        q: "Come costruite la pagina «Governo»?",
        a: [
          "L'elenco delle leggi viene dagli open data di Senato e Camera: numero, data, titolo ufficiale, tipo di atto, chi l'ha proposta, letture tra le Camere, voti finali e voti di fiducia (separati), Gazzetta Ufficiale e collegamento a Normattiva.",
          "«Proposta dal Governo in carica» vuol dire iniziativa governativa e, per i decreti-legge, adottati dopo l'insediamento del Governo. Le riforme costituzionali sono mostrate anche se non sono entrate in vigore.",
          "«In pratica» è un testo a modello fisso: spiega che tipo di atto è (decreto-legge, legge delega, ratifica…) e riporta date, durata dell'iter, eventuali fiducie ed esito dell'ultimo voto. Lo genera il programma dai dati, non contiene giudizi.",
          "«Come lo descrive il Governo» è un estratto del comunicato del Consiglio dei ministri sul testo iniziale, collegato alla legge per somiglianza del titolo e vicinanza delle date. È etichettato come presentazione del Governo.",
          "Per l'opinione pubblica usiamo solo atti ufficiali e misurabili: risultati dei referendum (Ministero dell'Interno), raccolte firme sulla piattaforma pubblica del Ministero della Giustizia (solo firme online) e pronunce della Corte costituzionale che citano la legge. Non usiamo sondaggi né commenti sui social: i sondaggi cambiano con domanda e campione, i social non rappresentano la popolazione.",
        ],
      },
    ],
  },
  {
    titolo: "Fonti e aggiornamenti",
    voci: [
      {
        id: "aggiornamento",
        q: "Ogni quanto si aggiornano i dati?",
        a: [
          "Ogni giorno alle 6:17 (ora italiana in estate). Camera e Senato pubblicano i voti con qualche giorno di ritardo rispetto alla seduta.",
          `Il periodo coperto è sempre «gli ultimi ${m.finestra.anni} anni», ricalcolato ogni giorno: oggi dal ${m.finestra.dal}. Per chi lascia la politica (ritiro o decesso) i dati si fermano alla data di fine attività.`,
          "Se una fonte non risponde, per quel giorno restano i dati precedenti e l'errore compare nella pagina Fonti.",
        ],
      },
      {
        id: "errori",
        q: "Ho trovato un errore. Cosa faccio?",
        a: [
          "Usa il modulo «Segnala un errore» su GitHub con il link alla fonte che lo dimostra. Rispondiamo in pubblico e correggiamo entro 72 ore. Anche i diretti interessati possono usarlo per il diritto di replica.",
          "Ogni modifica ai dati resta visibile nella cronologia pubblica del repository.",
        ],
      },
    ],
  },
];
---
<Base title="FAQ" description="Come sono calcolati tutti i numeri del sito: presenze, mediana, fedeltà al gruppo, cambi di posizione, coerenza, orientamento.">
  <section class="section">
    <div class="stack">
      <span class="eyebrow">Domande frequenti</span>
      <h1>Come calcoliamo i <span class="grad">numeri</span></h1>
      <p class="muted prose">Ogni indicatore è un rapporto tra conteggi presi da fonti ufficiali, con regole scritte prima di guardare i dati e uguali per tutti. Qui trovi formule, eccezioni e limiti.</p>
    </div>
    <nav class="row indice" aria-label="Argomenti">
      {gruppi.flatMap((g) => g.voci).map((v) => <a class="chip" href={`#${v.id}`}>{BREVE[v.id] ?? v.id}</a>)}
    </nav>
  </section>

  {gruppi.map((g) => (
    <section class="section">
      <h2>{g.titolo}</h2>
      <div>
        {g.voci.map((v) => (
          <details class="disc" id={v.id}>
            <summary><span>{v.q}</span><Icon name="chev" class="chev" /></summary>
            <div class="body prose">
              {v.formula && <p class="formula mono">{v.formula}</p>}
              {v.a.map((t) => <p>{t}</p>)}
              {v.esempio && <p class="callout">{v.esempio}</p>}
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}

  <p class="small muted" style="margin-top:28px">Le regole complete sono nel <a href={u("/metodologia/")}>metodo</a>; le licenze delle fonti in <a href={u("/fonti/")}>Fonti</a>.</p>
</Base>

<style>
  .indice { gap: 6px; }
  .indice .chip { height: 32px; font-size: 0.85rem; }
  .formula { background: var(--surface-2); border-radius: var(--r-s); padding: 10px 12px; font-size: 0.88rem; overflow-x: auto; }
</style>

<script>
  // apre la domanda richiamata dall'ancora (es. /faq/#orientamento)
  function apri() {
    const id = location.hash.slice(1);
    const d = id ? document.getElementById(id) : null;
    if (d instanceof HTMLDetailsElement) { d.open = true; d.scrollIntoView({ block: "start" }); }
  }
  document.addEventListener("astro:page-load", apri);
  addEventListener("hashchange", apri);
</script>
