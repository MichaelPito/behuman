---
import Base from "../../layouts/Base.astro";
import Filtri from "../../components/Filtri.astro";
import PersonaCard from "../../components/PersonaCard.astro";
import { perCognome, politici } from "../../lib/data";

const lista = politici().sort(perCognome);
---
<Base title="Politici" description="Esplora i politici monitorati: filtra per partito, sesso, orientamento e schieramento.">
  <section class="section">
    <div class="stack">
      <span class="eyebrow">Esplora</span>
      <h1>Politici <span class="grad">monitorati</span></h1>
      <p class="muted prose">
        {lista.length} esponenti di maggioranza e opposizione, con gli stessi indicatori per tutti. Filtra, cerca, poi apri una scheda
        per vedere ogni dato con la sua fonte.
      </p>
    </div>
    <Filtri lista={lista} />
    <div class="grid cards" data-griglia>
      {lista.map((p, i) => <PersonaCard p={p} i={i} />)}
    </div>
    <div class="callout neutral" data-vuoto hidden>
      Nessun politico corrisponde a questi filtri. Togline qualcuno o usa «Azzera filtri».
    </div>
  </section>
</Base>
